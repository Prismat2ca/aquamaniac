[sub_resource type="GDScript" id="GDScript_crnqq"]
resource_name = "bird"
script/source = "extends CharacterBody2D
var rand = RandomNumberGenerator.new()
@export var speed = 1
var angle = 0
var acc = Vector2(0,0)
var vel = Vector2(0,0)
var constantVel = 0
#takes in user movement and calculates acceleration and velocity.

func getInput():
	var inputDirection = Input.get_vector(\"left\", \"right\", \"up\", \"down\")
	#changes the angle based on left and right input
	angle +=inputDirection[0]*PI/150
	
	#makes acceleration a vector based on the angle
	#then multiplied by the vertical user input
	acc= Vector2.from_angle(angle)*speed*-inputDirection[1]
	vel+=acc
	vel*=0.9
	velocity -= vel

func _init():
	position = Vector2(rand.randi_range(10,160),200)
	scale = Vector2(1,1)*rand.randf_range(0.7,1.5)
	constantVel = (1/scale[0])
	z_index = scale[0]*10
func _physics_process(delta):
	
	velocity = Vector2(100,-100)*constantVel
	getInput()
	move_and_slide()
"

