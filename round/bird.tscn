resource_name = "bird"
script/source = "extends CharacterBody2D
var rand = RandomNumberGenerator.new()
var constantVel = 0




func _ready():
	#the position needs to be relative to the ship
	position = Vector2(rand.randi_range(-260,50)+global.shipPos[0],200+global.shipPos[1])
	scale = Vector2(1,1)*rand.randf_range(0.7,1.5)
	constantVel = (scale[0])
	z_index = scale[0]*10

	
func _physics_process(delta):
	#removes birds so object amount doesn't increase forever.
	if position[1] < -1000:
		queue_free()
	
	velocity = Vector2(100,-100)*constantVel

	move_and_slide()
"

