[sub_resource type="GDScript" id="GDScript_rbewk"]
script/source = "extends CharacterBody2D
@export var speed = 10
var rand = RandomNumberGenerator.new()
var age = 0

func _ready() -> void:
	#this process produces a random spot near the player to appear
	#it checks the distance so it does not spawn on the player
	while true:
		var pos = Vector2(rand.randf_range(-300,300)+global.shipPos[0],rand.randf_range(-300,300)+global.shipPos[1])
		
		if pos.distance_squared_to(global.shipPos)>50000:
			position = pos
			break
		
func _physics_process(delta):
	#makes it less variable on fps
	age+=delta
	
	#makes the spawn more obviously interactable, by having movement
	$\".\".rotate(PI/200)

	move_and_slide()
	#stops an infinite increase in spawns
	if age>=20:
		free()
"

