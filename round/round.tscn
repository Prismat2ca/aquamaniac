[sub_resource type="GDScript" id="GDScript_1l7ea"]
resource_name = "QuotaProgress"
script/source = "extends RichTextLabel

@export var title = \"Quota Progress: \"
func _ready():
	refresh()
#updates to the current value of progress
func refresh():
	#displays the progress to the quota referencing the global script in form 100/1000 etc
	$\".\".text = title+str(int(global.quotaProgress))+\"/\"+str(global.quota)

func _physics_process(delta: float) -> void:
	refresh()
"

