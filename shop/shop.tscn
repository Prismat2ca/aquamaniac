[sub_resource type="GDScript" id="GDScript_givde"]
script/source = "extends Node2D
@onready var money: RichTextLabel = $money


func _ready() -> void:
	#this means that the round will increment on any shop visit
	#which is guaranteed once per round
	global.updateRoundVars()
	#makes it display the correct money after adding the quota overflow
	money.updateDisplay()
"

[sub_resource type="GDScript" id="GDScript_xad5q"]
resource_name = "nextButton"
script/source = "extends TextureButton


func _on_pressed() -> void:
	get_tree().change_scene_to_file(\"res://round/round.tscn\")
	
"

[sub_resource type="GDScript" id="GDScript_q4g17"]
resource_name = "moneyText"
script/source = "extends RichTextLabel

@onready var globalScript = $\"/root/global\"
func _ready():
	#displays the progress to the quota referencing the global script in form 100/1000 etc
	updateDisplay()
func updateDisplay():
	$\".\".text = str(int(globalScript.money))+\"D\"
"

