[sub_resource type="GDScript" id="GDScript_1yahu"]
resource_name = "itemButton"
script/source = "extends TextureButton

#Gathered by dragging the node into the script while holding cntrl
@onready var money: RichTextLabel = $\"../../money\"
@onready var label = $\"../Label\"



func _on_pressed() -> void:
	#checks for enough money, and that it isnt already bought (invisible)
	if(global.money>=label.price and visible):
		global.money-=label.price
		money.updateDisplay()
		#keeps it as a node, so that it can be rerolled
		get_parent().visible = false
"

