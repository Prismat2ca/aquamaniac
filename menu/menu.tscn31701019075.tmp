[sub_resource type="GDScript" id="GDScript_pbjm4"]
resource_name = "optionsButton"
script/source = "extends TextureButton
@onready var sound: TextureButton = $\".\"


func _on_pressed() -> void:
	sound.play()
	get_tree().change_scene_to_file(\"res://options/options.tscn\")
"

