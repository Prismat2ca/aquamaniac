[sub_resource type="GDScript" id="GDScript_0o51j"]
resource_name = "settingsButton"
script/source = "extends TextureButton
var settingsScn = preload(\"res://settings/settings.tscn\")
func _on_pressed() -> void:
	#get_tree().change_scene_to_file(\"res://settings/settings.tscn\")
	
	var settings = settingsScn.instantiate()
	get_tree().current_scene.add_child(settings)
	#get_tree().change_scene_to_file(\"res://options/options.tscn\")
"

