[sub_resource type="GDScript" id="GDScript_c0xh2"]
resource_name = "difficultySlider"
script/source = "extends HSlider
@onready var globalScript = $\"/root/global\"

#saves value during instance of game
func _ready() -> void:
	if FileAccess.file_exists(\"user://difficulty.dat\"):
		var file = FileAccess.open(\"user://difficulty.dat\",FileAccess.READ)
		value = file.get_float()
		file.close()
	
	else:
		var file = FileAccess.open(\"user://difficulty.dat\",FileAccess.WRITE)
		file.store_float(value)
		file.close()

#this lowers how often the function is called
#reducing how intensive it is
func _on_drag_ended(value_changed: bool) -> void:
	match value:
		0.0:
			globalScript.difficulty = globalScript.DIFFICULTY_TYPE.EASY
		2.0:
			globalScript.difficulty = globalScript.DIFFICULTY_TYPE.HARD
		_:
			globalScript.difficulty = globalScript.DIFFICULTY_TYPE.NORMAL
			
	var file = FileAccess.open(\"user://difficulty.dat\",FileAccess.WRITE)
	file.store_float(value)
	file.close()
"

